# Copy this file to `.env` and adjust values. `.env` is git-ignored.
# Docker Compose auto-loads `.env` from this directory.

# --- Database ---
DB_NAME=expense_tracker_db
DB_USERNAME=postgres
DB_PASSWORD=1234

# --- Backend secrets (use long random values in real deployments) ---
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-bytes
ENCRYPTION_KEY=change-me-to-a-random-encryption-secret

# --- Optional: Gemini AI (leave as no-key to disable AI features) ---
GEMINI_API_KEY=no-key
